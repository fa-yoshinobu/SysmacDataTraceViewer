<Window x:Class="SysmacDataTraceViewer.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Title="Sysmac Data Trace Viewer"
        Icon="app.ico"
        Background="#F5F6F8"
        Width="1400"
        Height="840"
        MinWidth="1000"
        MinHeight="700"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="GridCellEditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FCFCFD" />
            <Setter Property="BorderBrush" Value="#C9CFDA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="HexEditorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource GridCellEditorTextBoxStyle}">
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="220" />
            <RowDefinition x:Name="BottomPanelSplitterRow" Height="6" />
            <RowDefinition x:Name="BottomPanelRow" Height="2*" MinHeight="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,8">
            <Menu Background="#ECEFF3" Foreground="#1F2937">
                <MenuItem Header="_File">
                    <MenuItem Header="_Open Trace CSV..." Click="LoadCsv_Click" InputGestureText="Ctrl+O" />
                    <MenuItem Header="_Export Chart PNG">
                        <MenuItem Header="Export _Visible Range PNG..." Click="SavePng_Click" InputGestureText="Ctrl+E" />
                        <MenuItem Header="Export _Full Range PNG..." Click="SavePngFullRange_Click" />
                    </MenuItem>
                    <MenuItem Header="_Load Comments..." Click="LoadComments_Click" />
                    <MenuItem Header="_Save Comments..." Click="SaveComments_Click" />
                    <Separator />
                    <MenuItem Header="E_xit" Click="Close_Click" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem x:Name="ShowTypeSuffixMenuItem"
                              Header="Show Type Suffix"
                              IsCheckable="True"
                              IsChecked="False"
                              Checked="ShowTypeSuffixCheckBox_Changed"
                              Unchecked="ShowTypeSuffixCheckBox_Changed" />
                    <MenuItem x:Name="ShowRangeBandMenuItem"
                              Header="Show Range Band"
                              IsCheckable="True"
                              IsChecked="False"
                              Checked="RangeBandCheckBox_Changed"
                              Unchecked="RangeBandCheckBox_Changed" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_About" Click="About_Click" />
                </MenuItem>
            </Menu>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="ToggleBoolPanelButton" Width="140" Height="30" Margin="0,0,0,0" Content="Hide Right Panel" Click="ToggleBoolPanel_Click" />
                <Button x:Name="ToggleBottomPanelButton" Width="180" Height="30" Margin="6,0,0,0" Content="Hide Variable Settings" Click="ToggleBottomPanel_Click" />
                <Button Width="140" Height="30" Margin="6,0,0,0" Content="Swap Red/Blue Cursors" Click="SwapCursors_Click" />
                <Button Width="130" Height="30" Margin="6,0,0,0" Content="Previous Change" Click="JumpPrevChange_Click" />
                <Button Width="120" Height="30" Margin="6,0,0,0" Content="Next Change" Click="JumpNextChange_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock VerticalAlignment="Center" Text="Label Mode:" />
                <ComboBox x:Name="LabelModeComboBox" Width="130" Margin="6,0,0,0" VerticalAlignment="Center" SelectionChanged="LabelModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Variable Name" IsSelected="True" />
                    <ComboBoxItem Content="Comment" />
                </ComboBox>
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="Change Jump Scope:" />
                <ComboBox x:Name="JumpScopeComboBox" Width="190" Margin="6,0,0,0" VerticalAlignment="Center" SelectionChanged="JumpScopeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Visible BOOL Variables" IsSelected="True" />
                    <ComboBoxItem Content="Selected BOOL Variable" />
                </ComboBox>
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="Elapsed Time:" />
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding CursorTimeText}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="Recorded Time:" />
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding CursorClockText}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="Sample Index:" />
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding CursorSampleText}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="Cursor Delta:" />
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding CursorDeltaText}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="Hover State:" />
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding HoverStateText}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="State Duration:" />
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding HoverDurationText}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding StatusText}" />
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="BoolPanelSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="BoolPanelColumn" Width="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Column="0" Grid.Row="0" Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NameAreaColumn" Width="180" MinWidth="150" MaxWidth="420" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Column="0" Grid.Row="0" BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="BOOL Variables"
                                   FontWeight="SemiBold"
                                   Foreground="#4B5563"
                                   Margin="2,0,2,4" />
                        <ScrollViewer x:Name="NameLaneScrollViewer"
                                      Grid.Row="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <Grid x:Name="NameLaneGrid" Margin="2" />
                        </ScrollViewer>
                    </Grid>
                </Border>
                <ScrollBar x:Name="NameLaneScrollBar"
                           Grid.Column="0"
                           Grid.Row="1"
                           Height="14"
                           Orientation="Horizontal"
                           Minimum="0"
                           Maximum="1"
                           ViewportSize="1"
                           ValueChanged="NameLaneScrollBar_ValueChanged" />

                <GridSplitter Grid.Column="1"
                              Grid.RowSpan="2"
                              Width="6"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#E0E0E0"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              ShowsPreview="True" />

                <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" BorderBrush="#DDD" BorderThickness="1" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Time Chart"
                                   FontWeight="SemiBold"
                                   Foreground="#4B5563"
                                   Margin="2,0,2,4" />
                        <oxy:PlotView x:Name="TracePlot" Grid.Row="1" />
                    </Grid>
                </Border>
            </Grid>

            <ScrollBar x:Name="TimeScrollBar"
                       Grid.Column="0"
                       Grid.Row="1"
                       Margin="0,6,0,0"
                       Height="16"
                       Orientation="Horizontal"
                       Minimum="0"
                       Maximum="1"
                       ViewportSize="1"
                       SmallChange="0.1"
                       LargeChange="0.5"
                       ValueChanged="TimeScrollBar_ValueChanged" />

            <GridSplitter x:Name="BoolPanelSplitter"
                          Grid.Column="1"
                          Grid.RowSpan="2"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#E0E0E0"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <Border x:Name="BoolPanelBorder" Grid.Column="2" Grid.RowSpan="2" BorderBrush="#DDD" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Value Variables at Cursor"
                               FontWeight="SemiBold"
                               Foreground="#4B5563"
                               Margin="0,0,0,6" />
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding VisibleValueSignals}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Variables" Binding="{Binding DisplayName}" Width="2*" />
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter x:Name="BottomPanelSplitter"
                      Grid.Row="3"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="#E0E0E0"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True" />

        <Border x:Name="BottomPanelBorder" Grid.Row="4" BorderBrush="#DDD" BorderThickness="1" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="Variable Visibility / Comments" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="BOOL Variables" />
                            <Button Margin="8,0,0,0" Padding="6,2" Content="Select All" Click="AllBoolOn_Click" />
                            <Button Margin="6,0,0,0" Padding="6,2" Content="Clear All" Click="AllBoolOff_Click" />
                            <Button Margin="6,0,0,0" Padding="6,2" Content="Hide No Change" Click="HideNoChangeBool_Click" />
                            <Button Margin="6,0,0,0" Padding="6,2" Content="Auto Assign Colors" Click="AutoBoolColors_Click" />
                        </StackPanel>
                        <ListView x:Name="BoolSignalsListBox"
                                  Grid.Row="1"
                                  Margin="0,6,0,0"
                                  ItemsSource="{Binding BoolSignals}"
                                  SelectionChanged="BoolSignalsListBox_SelectionChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="BoolSignalsListBox_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="BoolSignalsListBox_PreviewMouseMove"
                                  Drop="BoolSignalsListBox_Drop"
                                  DragOver="BoolSignalsListBox_DragOver">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Visible" Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Name" Width="240">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="Black" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True" />
                                                                        <Condition Binding="{Binding DataContext.IsSelectedBoolJumpMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Foreground" Value="Red" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Color" Width="95">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource HexEditorTextBoxStyle}"
                                                         ToolTip="#RRGGBB" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Comment" Width="360">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource GridCellEditorTextBoxStyle}"
                                                         ToolTip="Comment" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="Value Variables" />
                            <Button Margin="8,0,0,0" Padding="6,2" Content="Select All" Click="AllValueOn_Click" />
                            <Button Margin="6,0,0,0" Padding="6,2" Content="Clear All" Click="AllValueOff_Click" />
                            <Button Margin="6,0,0,0" Padding="6,2" Content="Hide No Change" Click="HideNoChangeValue_Click" />
                        </StackPanel>
                        <ListView x:Name="ValueSignalsListBox"
                                  Grid.Row="1"
                                  Margin="0,6,0,0"
                                  ItemsSource="{Binding ValueSignals}"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="ValueSignalsListBox_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="ValueSignalsListBox_PreviewMouseMove"
                                  Drop="ValueSignalsListBox_Drop"
                                  DragOver="ValueSignalsListBox_DragOver">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Visible" Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Name" Width="240" DisplayMemberBinding="{Binding SettingsDisplayNameWithState}" />
                                    <GridViewColumn Header="Comment" Width="360">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CommentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource GridCellEditorTextBoxStyle}"
                                                         ToolTip="Comment" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <GridSplitter Grid.Column="1"
                                  Width="6"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#E0E0E0"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True" />
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5"
                   Margin="0,8,0,0"
                   Foreground="#666"
                   Text="Left drag: data cursor. Right drag: delta cursor. Timeline starts at 00:00." />
    </Grid>
</Window>

