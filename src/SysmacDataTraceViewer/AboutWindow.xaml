<Window x:Class="SysmacDataTraceViewer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Sysmac Data Trace Viewer"
        Icon="app.ico"
        Width="700"
        Height="560"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="#DDD" BorderThickness="1" Padding="10">
            <StackPanel>
                <TextBlock Text="Sysmac Data Trace Viewer" FontSize="20" FontWeight="Bold" />
                <TextBlock x:Name="VersionTextBlock" Margin="0,4,0,0" />
                <TextBlock Margin="0,2,0,0" Text="Author: fa-yoshinobu" />
                <TextBlock Margin="0,6,0,0">
                    <Run Text="GitHub: " />
                    <Hyperlink NavigateUri="https://github.com/fa-yoshinobu/SysmacDataTraceViewer"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        https://github.com/fa-yoshinobu/SysmacDataTraceViewer
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2">
            <TabItem Header="Libraries">
                <Grid Margin="8">
                    <ListView x:Name="LibrariesListView">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Library" Width="220" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Version" Width="90" DisplayMemberBinding="{Binding Version}" />
                                <GridViewColumn Header="License" Width="120" DisplayMemberBinding="{Binding License}" />
                                <GridViewColumn Header="Notes" Width="230" DisplayMemberBinding="{Binding Notes}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Open Source Licenses">
                <Grid Margin="8">
                    <TextBox x:Name="LicenseTextBox"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Height="30" Content="Close" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
